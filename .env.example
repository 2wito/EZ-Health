# PostgreSQL (Prisma Postgres, Supabase or any Postgres)
# Prisma Postgres (Vercel integration): use the direct postgres://...@db.prisma.io URL,
#   not the prisma+postgres:// one (PRISMA_DATABASE_URL). The integration sets DATABASE_URL for you.
# Supabase: use the pooled "Transaction" URL (port 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ez_health"
# Direct connection for `prisma migrate` (Supabase: port 5432). Leave empty for Prisma Postgres.
DIRECT_URL=""

# Shared secret the Health Auto Export app sends in the `x-api-key` header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=""

# AI Coach: set one of these. The provider is picked from whichever key is present.
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional explicit model, e.g. "openai:gpt-5.4-mini" or "google:gemini-flash-latest"
AI_COACH_MODEL=""
