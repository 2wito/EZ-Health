# PostgreSQL (Supabase or any Postgres)
# Runtime connection. On Supabase use the pooled "Transaction" URL (port 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ez_health"
# Direct connection for `prisma migrate` (Supabase: port 5432). Optional elsewhere.
DIRECT_URL=""

# Shared secret the Health Auto Export app sends in the `x-api-key` header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=""

# AI Coach: set one of these. The provider is picked from whichever key is present.
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional explicit model, e.g. "openai:gpt-5.4-mini" or "google:gemini-flash-latest"
AI_COACH_MODEL=""
